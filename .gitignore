# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Build output of the example app and of the packages
build/
.gradle/
.kotlin/

# Platform ephemeral and machine-local artifacts
**/ephemeral/
**/local.properties
**/.symlinks/
**/Pods/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
macos/Flutter/Flutter-Generated.xcconfig
macos/Flutter/ephemeral/

# Golden-failure artefacts, written by flutter_test when a pixel golden drifts.
# There are no pixel goldens now - see TESTING.md - so this only matters if one
# ever comes back.
test/**/failures/

# Signing is per developer - see ios/Flutter/Signing.xcconfig.example
ios/Flutter/Signing.xcconfig

# What a run of e2e/agent-device/run.sh leaves behind
/e2e/agent-device/artifacts/
.agent-device/
/maestro/native/artifacts/
